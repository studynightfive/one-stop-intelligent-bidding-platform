{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@specs/*": ["specs/*"],
      "@helpers/*": ["helpers/*"]
    }
  },
  "include": ["pages/**/*", "specs/**/*", "helpers/**/*", "*.ts", "*.config.ts"]
}
