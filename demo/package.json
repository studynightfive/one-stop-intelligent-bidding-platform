{
  "name": "bid-platform-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.x",
    "npm": "11.13.x"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "contract:generate": "openapi-typescript ../contracts/openapi.yaml --output src/api/generated/schema.ts",
    "contract:check": "npm run contract:generate && git diff --exit-code -- src/api/generated/schema.ts"
  },
  "dependencies": {
    "antd": "5.29.3",
    "lucide-react": "0.400.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "dayjs": "1.11.21"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
