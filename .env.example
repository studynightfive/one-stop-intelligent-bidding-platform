COMPOSE_PROJECT_NAME=bidplat2026
ENVIRONMENT=development
TZ=UTC

WEB_HOST=127.0.0.1
WEB_PORT=3210
API_HOST=127.0.0.1
API_PORT=8210
VITE_API_BASE_URL=http://127.0.0.1:8210/api/v1
VITE_USE_MOCKS=false
OPENAPI_CONTRACT_PATH=/workspace/contracts/openapi.yaml

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=55432
POSTGRES_DB=bid_platform
POSTGRES_USER=bid_platform
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://bid_platform:change-me-local-only@postgres:5432/bid_platform

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=56379
REDIS_KEY_PREFIX=bidplat:development
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=http://minio:9000
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
MINIO_ROOT_USER=bid_platform_local
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_BUCKET=bid-platform
MINIO_SECURE=false

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@bid-platform.local
MAILPIT_SMTP_HOST_PORT=51025
MAILPIT_WEB_HOST_PORT=58025

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PORTAL_ACCESS_TOKEN_TTL_MINUTES=30

MODEL_MASTER_KEY_PATH=/run/secrets/model_master_key
AI_FAKE_PROVIDER=true
AI_DEFAULT_PROVIDER=qwen
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

CORS_ORIGINS=http://127.0.0.1:3210
LOG_LEVEL=INFO

FLOWER_HOST_PORT=5556
PROMETHEUS_HOST_PORT=59090
GRAFANA_HOST_PORT=53000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
